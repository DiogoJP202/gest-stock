{
  "info": {
    "name": "Gest-Stock API",
    "_postman_id": "c3d2f3f0-gest-stock-api",
    "description": "Collection com todos os endpoints atuais da API Gest-Stock.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000"
    },
    {
      "key": "nome",
      "value": "Mini Mercado X"
    },
    {
      "key": "cnpj",
      "value": "12345678000199"
    },
    {
      "key": "email",
      "value": "mercado@email.com"
    },
    {
      "key": "celular",
      "value": "5511999999999"
    },
    {
      "key": "senha",
      "value": "123456"
    },
    {
      "key": "activation_code",
      "value": ""
    },
    {
      "key": "access_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "description": "Verifica se o servidor Flask esta no ar.",
        "url": {
          "raw": "{{base_url}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            ""
          ]
        }
      }
    },
    {
      "name": "02 - API Status",
      "request": {
        "method": "GET",
        "header": [],
        "description": "Retorna o status geral da API.",
        "url": {
          "raw": "{{base_url}}/api",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api"
          ]
        }
      }
    },
    {
      "name": "03 - Create User",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  const user = data['usuarios cadastrados'] || {};",
              "  if (user.codigoTwilio) {",
              "    pm.collectionVariables.set('activation_code', user.codigoTwilio);",
              "  }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "description": "Cria um usuario e captura o codigo de ativacao retornado no payload.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"{{nome}}\",\n  \"cnpj\": \"{{cnpj}}\",\n  \"email\": \"{{email}}\",\n  \"celular\": \"{{celular}}\",\n  \"senha\": \"{{senha}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/user",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "user"
          ]
        }
      }
    },
    {
      "name": "04 - Activate User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "description": "Ativa o usuario usando email e codigo de ativacao salvo na collection.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"codigoAtivacao\": \"{{activation_code}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/ativarUsuario",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "ativarUsuario"
          ]
        }
      }
    },
    {
      "name": "05 - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  if (data.access_token) {",
              "    pm.collectionVariables.set('access_token', data.access_token);",
              "  }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "description": "Efetua login e salva o bearer token na collection.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"senha\": \"{{senha}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "login"
          ]
        }
      }
    },
    {
      "name": "06 - List Users",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "description": "Lista os usuarios usando autenticacao bearer.",
        "url": {
          "raw": "{{base_url}}/users",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "users"
          ]
        }
      }
    },
    {
      "name": "07 - Test Twilio WhatsApp",
      "request": {
        "method": "GET",
        "header": [],
        "description": "Dispara o envio de uma mensagem de teste para o numero fixo configurado no controller.",
        "url": {
          "raw": "{{base_url}}/testarNumero",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "testarNumero"
          ]
        }
      }
    }
  ]
}
